#!/usr/bin/env perl
use strict;
use warnings;
use feature 'state';
use experimental 'signatures';

use XML::Feed;
use JSON;
use Path::Tiny;
use DateTime;
use DateTime::Format::Strptime;

my $parser = JSON->new;
my $config = $parser->decode(path('config.json')->slurp_utf8);
my $file = shift || 'history.json';
my $data = $parser->decode(path($file)->slurp_utf8);
my $history = ref($data) eq 'ARRAY' ? $data : $data->{history};
die "History must be a JSON array\n" unless ref($history) eq 'ARRAY';

my @history = sort { $b->{watched_at} cmp $a->{watched_at} }
              grep { ($_->{type} // '') eq 'episode' } @$history;
splice @history, 20 if @history > 20;
die "No TV episodes found in history\n" unless @history;

my $feed = XML::Feed->new('Atom');
my $feed_link = $config->{feed_link};
$feed->$_($feed_link) for qw[id link self_link];
$feed->title($config->{feed_title});
$feed->modified(DateTime->now(time_zone => 'UTC'));
$feed->author($config->{feed_author});

for my $event (@history) {
  my $entry = XML::Feed::Entry->new;
  my $link = mklink($event);
  $entry->link($link);
  $entry->id('tag:trakt.tv,2026:history/' . $event->{id});
  $entry->title(mktitle($event));
  $entry->modified(mktime($event));
  $entry->author($config->{feed_author});
  $feed->add_entry($entry);
}

print $feed->as_xml;

sub mklink ($event) {
  return sprintf 'https://trakt.tv/shows/%s/seasons/%d/episodes/%d',
    $event->{show}{ids}{slug},
    $event->{episode}{season},
    $event->{episode}{number};
}

sub mktitle ($event) {
  return sprintf '%s [S%02dE%02d]: %s',
    $event->{show}{title},
    $event->{episode}{season},
    $event->{episode}{number},
    $event->{episode}{title};
}

sub mktime ($event) {
  state $parser = DateTime::Format::Strptime->new(
    pattern => '%Y-%m-%dT%H:%M:%S.%3NZ',
    time_zone => 'UTC',
    on_error => 'croak',
  );
  return $parser->parse_datetime($event->{watched_at});
}
